<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ✅ Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/elderhero"
        android:label="@string/app_name"
        android:name=".ElderHeroApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ElderHero"
        tools:targetApi="31">
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".advertisement.AdvertiseServicePreviewActivity"
            android:exported="false" />
        <activity
            android:name=".ReportBookingActivity"
            android:exported="false" />
        <activity
            android:name=".MyReportsActivity"
            android:exported="false" />
        <activity
            android:name=".SubmissionHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".advertisement.EditAdvertisementActivity"
            android:exported="false" />
        <activity
            android:name=".advertisement.MyAdvertisementsActivity"
            android:exported="false" />
        <activity
            android:name=".EditCaretakerProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ScanQRCodeActivity"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CaretakerHomePreviewActivity"
            android:exported="false" />
        <activity
            android:name=".chats.CaretakerMessagesActivity"
            android:exported="false" />
        <activity
            android:name=".chats.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".booking.CaretakerBookingListActivity"
            android:exported="false" />
        <activity
            android:name=".advertisement.AdvertiseServiceActivity"
            android:exported="false" />
        <activity
            android:name=".SubmissionActivity"
            android:exported="false" />
        <activity
            android:name=".CaretakerProfileActivity"
            android:exported="false" />
        <activity
            android:name=".CaretakerHomeActivity"
            android:exported="false" />
        <activity
            android:name=".authenticate.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".authenticate.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>