<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F5F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="#5A3D2B">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_menu"
                app:tint="@android:color/white"
                android:background="@android:color/transparent" />

            <TextView
                android:text="Post Ad (Preview)"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Category"
                    android:textColor="#5A3D2B"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:text="Sub-Services"
                    android:textColor="#5A3D2B"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/layoutSubServices"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:text="Availability"
                    android:textColor="#5A3D2B"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <Spinner
                    android:id="@+id/spinnerAvailability"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:text="Price Range (RM)"
                    android:textStyle="bold"
                    android:textColor="#5A3D2B"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:weightSum="2">

                    <EditText
                        android:id="@+id/etPriceMin"
                        android:hint="Min (e.g. 20)"
                        android:inputType="numberDecimal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:drawable/edit_text"
                        android:padding="10dp"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/etPriceMax"
                        android:hint="Max (e.g. 35)"
                        android:inputType="numberDecimal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:drawable/edit_text"
                        android:padding="10dp"/>
                </LinearLayout>

                <TextView
                    android:text="Location"
                    android:textStyle="bold"
                    android:textColor="#5A3D2B"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/etLocation"
                    android:hint="City / Area"
                    android:inputType="textPostalAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="24dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="#F0EAE0"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Join ElderHero to Post Your Services"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#5A3D2B"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/btnSignUp"
                        android:text="Sign Up Now"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:backgroundTint="#5A3D2B"
                        android:textColor="@android:color/white"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btnLogin"
                        android:text="Already have an account? Log In"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:backgroundTint="#FFFFFF"
                        android:textColor="#5A3D2B"
                        android:stateListAnimator="@null"
                        style="?android:attr/borderlessButtonStyle"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawerView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <include layout="@layout/layout_caretaker_drawer" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>