<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F5F0">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="#5A3D2B">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_menu"
                app:tint="@android:color/white"
                android:background="@android:color/transparent" />

            <TextView
                android:text="Post Advertisement"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Category"
                    android:textStyle="bold"
                    android:textColor="#5A3D2B"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:text="Sub-Category"
                    android:textStyle="bold"
                    android:textColor="#5A3D2B"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/layoutSubServices"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:text="Availability"
                    android:textStyle="bold"
                    android:textColor="#5A3D2B"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Spinner
                    android:id="@+id/spinnerAvailability"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFF9C4"
                    android:padding="12dp"
                    android:layout_marginBottom="14dp"
                    android:elevation="2dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvWarning"
                        android:text="Final pricing may vary based on patient’s condition and care needs. Please provide your estimated total price range below."
                        android:textSize="13.5sp"
                        android:textColor="#5A3D2B"
                        android:lineSpacingExtra="2dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:text="Price Range"
                    android:textStyle="bold"
                    android:textColor="#5A3D2B"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:weightSum="2">

                    <EditText
                        android:id="@+id/editRateMin"
                        android:hint="Min (e.g. 20)"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:drawable/edit_text"
                        android:inputType="numberDecimal"
                        android:padding="10dp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/editRateMax"
                        android:hint="Max (e.g. 35)"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:drawable/edit_text"
                        android:inputType="numberDecimal"
                        android:padding="10dp" />
                </LinearLayout>

                <TextView
                    android:text="Service Area"
                    android:textStyle="bold"
                    android:textColor="#5A3D2B"
                    android:textSize="15sp"
                    android:layout_marginBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/editLocation"
                    android:hint="Location / Area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:text="📷 Add photo (optional)"
                    android:textSize="16sp"
                    android:textColor="#5A3D2B"
                    android:layout_marginBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imagePreview"
                        android:src="@drawable/ic_add_photo"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:background="@android:color/darker_gray"
                        android:padding="8dp"
                        android:layout_marginBottom="16dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSubmitAd"
                    android:text="Post Advertisement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:backgroundTint="#5A3D2B"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include
        layout="@layout/layout_caretaker_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />
</androidx.drawerlayout.widget.DrawerLayout>