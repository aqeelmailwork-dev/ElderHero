<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Caretaker Info -->
        <TextView
            android:text="Caretaker Information"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5A3D2B"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/caretakerImg"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder"
                android:layout_marginEnd="12dp"
                android:background="@android:color/darker_gray" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/caretakerName"
                    android:text="Name: -"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:textSize="16sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/caretakerGender"
                    android:text="Gender: -"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/caretakerRace"
                    android:text="Race: -"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/caretakerAge"
                    android:text="Age: -"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/caretakerLang"
                    android:text="Languages: -"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDD"
            android:layout_marginBottom="10dp" />

        <!-- 🔹 Price Notice -->
        <TextView
            android:id="@+id/tvPriceNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="10dp"
            android:background="#FFF7E6"
            android:textColor="#7A4E0E"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:gravity="center"
            android:text="💡 Note: Rates shown are ranging prices. The final cost may vary based on the patient's condition or service complexity. Please message the caretaker to confirm the exact price." />

        <!-- Service Info -->
        <TextView
            android:text="Service Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5A3D2B"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/serviceCategory"
            android:text="Category: -"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/serviceRate"
            android:text="Rate: -"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/serviceLocation"
            android:text="Location: -"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/serviceAvailability"
            android:text="Availability: -"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/serviceSubServices"
            android:text="Sub-services: -"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnWhatsApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#25D366"
                android:padding="10dp"
                android:text="WhatsApp"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnChat"
                android:text="Chat Caretaker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#0078FF"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnBook"
                android:text="Book Now"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#5A3D2B"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:padding="10dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
