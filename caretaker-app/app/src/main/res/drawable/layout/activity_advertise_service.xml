<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F5F0">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Category -->
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Sub-services -->
        <LinearLayout
            android:id="@+id/layoutSubServices"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- Availability -->
        <Spinner
            android:id="@+id/spinnerAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- 🔹 Price Range -->
        <TextView
            android:text="Price Range (per hour)"
            android:textStyle="bold"
            android:textColor="#5A3D2B"
            android:textSize="15sp"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:weightSum="2">

            <EditText
                android:id="@+id/editRateMin"
                android:hint="Min (e.g. 20)"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/editRateMax"
                android:hint="Max (e.g. 35)"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:inputType="numberDecimal"
                android:padding="10dp"/>
        </LinearLayout>

        <TextView
            android:text="💬 Final pricing depends on patient needs — please contact caretaker for exact quote."
            android:textSize="13sp"
            android:textColor="#555"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Location -->
        <EditText
            android:id="@+id/editLocation"
            android:hint="Location / Area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- Image Upload -->
        <TextView
            android:text="📷 Add photo (optional)"
            android:textSize="16sp"
            android:textColor="#5A3D2B"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <ImageView
                android:id="@+id/imagePreview"
                android:src="@drawable/ic_add_photo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@android:color/darker_gray"
                android:padding="8dp"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSubmitAd"
            android:text="Post Advertisement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:backgroundTint="#5A3D2B"
            android:textColor="@android:color/white"/>
    </LinearLayout>
</ScrollView>
