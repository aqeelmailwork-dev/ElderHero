<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="12dp"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_margin="8dp"
    android:elevation="2dp"
    android:backgroundTint="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 🧑‍🤝‍🧑 Family / Elderly Name -->
    <TextView
        android:id="@+id/tvFamilyName"
        android:text="Booked By: Family Name"
        android:textStyle="bold"
        android:textColor="#5A3D2B"
        android:textSize="16sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- 📅 Date and Time -->
    <TextView
        android:id="@+id/tvDateTime"
        android:text="2025-10-10 • 10:00 - 12:00"
        android:textColor="#333"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- 💰 Rate Info -->
    <TextView
        android:id="@+id/tvRate"
        android:text="Rate: RM25/hour"
        android:textColor="#444"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 📝 Notes -->
    <TextView
        android:id="@+id/tvNotes"
        android:text="Notes: Address or additional info"
        android:textColor="#333"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- 🔖 Booking Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:text="Status: Pending"
        android:textStyle="bold"
        android:textColor="#5A3D2B"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- ✅ Accept / Reject (Caretaker Only When Pending) -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnAccept"
            android:text="Accept"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"/>

        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnReject"
            android:text="Reject"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#F44336"
            android:textColor="@android:color/white"/>
    </LinearLayout>

</LinearLayout>
