<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/leftDrawer"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:background="#F6F5F0"
    android:padding="20dp"
    android:elevation="8dp">

    <!-- USER PROFILE SECTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/drawerUserImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_profile"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_bg"
            android:layout_marginBottom="8dp"
            android:clipToOutline="true" />

        <TextView
            android:id="@+id/drawerUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="#5A3D2B"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDD"
        android:layout_marginBottom="20dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HOME -->
            <LinearLayout
                android:id="@+id/menuHome"
                style="@style/DrawerMenuItem">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_home"
                    app:tint="#5A3D2B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="18sp"
                    android:textColor="#5A3D2B"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <!-- PROFILE -->
            <LinearLayout
                android:id="@+id/menuProfile"
                style="@style/DrawerMenuItem">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_person_placeholder"
                    app:tint="#5A3D2B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="18sp"
                    android:textColor="#5A3D2B"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <!-- BOOKING -->
            <LinearLayout
                android:id="@+id/menuBooking"
                style="@style/DrawerMenuItem">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_booking"
                    app:tint="#5A3D2B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking"
                    android:textSize="18sp"
                    android:textColor="#5A3D2B"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <!-- VIEW JOBS -->
            <LinearLayout
                android:id="@+id/menuJobs"
                style="@style/DrawerMenuItem">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_view_jobs"
                    app:tint="#5A3D2B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find Caretakers"
                    android:textSize="18sp"
                    android:textColor="#5A3D2B"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <!-- MESSAGES -->
            <LinearLayout
                android:id="@+id/menuMessages"
                style="@style/DrawerMenuItem">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_message"
                    app:tint="#5A3D2B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chats"
                    android:textSize="18sp"
                    android:textColor="#5A3D2B"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

            <!-- ✅ MY REPORTS -->
            <LinearLayout
                android:id="@+id/menuReports"
                style="@style/DrawerMenuItem">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_report"
                    app:tint="#5A3D2B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Reports"
                    android:textSize="18sp"
                    android:textColor="#5A3D2B"
                    android:layout_marginStart="14dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- LOGOUT -->
    <LinearLayout
        android:id="@+id/menuLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginTop="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_logout"
            app:tint="#5A3D2B" />

        <TextView
            android:id="@+id/menuText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Out"
            android:textSize="18sp"
            android:textColor="#5A3D2B"
            android:layout_marginStart="12dp" />
    </LinearLayout>

</LinearLayout>
