<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F2">

    <TextView
        android:id="@+id/tvCaretakerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Chat"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="#5A3D2B"
        android:textColor="@android:color/white" />

    <ListView
        android:id="@+id/listMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="8dp"
        android:padding="10dp"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#EDE7E3"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Send Image"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#5A3D2B" />

        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:layout_marginStart="8dp"
            android:contentDescription="Record Voice"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#5A3D2B" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="Type a message..."
            android:background="@android:drawable/edit_text"
            android:padding="10dp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Send"
            android:backgroundTint="#5A3D2B"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
