<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F5F0"
        android:padding="20dp">

        <RelativeLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- MENU BUTTON -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu" />

            <!-- APP LOGO -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_centerHorizontal="true"
                android:layout_below="@id/btnMenu"
                android:layout_marginTop="60dp"
                android:src="@drawable/elderhero"
                android:contentDescription="ElderHero Logo"
                android:adjustViewBounds="true" />

            <!-- WELCOME TEXT -->
            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/logo"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:text="Welcome, Family"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#5A3D2B" />

            <!-- DASHBOARD SECTION -->
            <LinearLayout
                android:id="@+id/dashboardCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/welcomeText"
                android:layout_marginTop="40dp"
                android:orientation="vertical">

                <!-- First Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="16dp">

                    <!-- Pending Requests -->
                    <LinearLayout
                        android:id="@+id/cardPending"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:elevation="3dp"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending Requests"
                            android:textColor="#5A3D2B"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/tvPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#A57A3C"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Upcoming Visit -->
                    <LinearLayout
                        android:id="@+id/cardUpcoming"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:elevation="3dp"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upcoming Visit"
                            android:textColor="#5A3D2B"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/tvUpcomingDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No visit scheduled"
                            android:textColor="#A57A3C"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tvUpcomingTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#A57A3C"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Second Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Unreviewed -->
                    <LinearLayout
                        android:id="@+id/cardUnreviewed"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:elevation="3dp"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unreviewed"
                            android:textColor="#5A3D2B"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/tvUnreviewedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#A57A3C"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Completed Visits -->
                    <LinearLayout
                        android:id="@+id/cardCompletedVisits"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:elevation="3dp"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completed Visits"
                            android:textColor="#5A3D2B"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/tvCompletedVisitsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#A57A3C"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

    <!-- The Drawer Menu -->
    <include layout="@layout/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
