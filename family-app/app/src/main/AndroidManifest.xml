<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.elderhero_familiyelderly">
    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".ElderHeroApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/elderhero"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/elderhero"
        android:supportsRtl="true"
        android:theme="@style/Theme.ElderHero"
        tools:targetApi="31">
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ReportAdapter"
            android:exported="false" />
        <activity
            android:name=".MyReportsActivity"
            android:exported="false" />
        <activity
            android:name=".ReportBookingActivity"
            android:exported="false" /> <!-- Activities -->
        <activity
            android:name=".EditFamilyProfileActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyMessagesActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ChatActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyViewAllReviewsActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyLeaveReviewActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyHomePreviewActivity"
            android:exported="false" /> <!-- Splash (Launcher) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Bookings -->
        <activity
            android:name=".booking.FamilyBookingListActivity"
            android:exported="false" />
        <activity
            android:name=".booking.BookingActivity"
            android:exported="false" />
        <activity
            android:name=".booking.ShowBookingQRCodeActivity"
            android:exported="false" /> <!-- Services -->
        <activity
            android:name=".BrowseServicesActivity"
            android:exported="false" />
        <activity
            android:name=".AdvertiseServiceActivity"
            android:exported="false" /> <!-- Auth -->
        <activity
            android:name=".FamilyProfileActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyLoginActivity"
            android:exported="false" />
        <activity
            android:name=".FamilyRegisterActivity"
            android:exported="false" /> <!-- Main activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
    </application>

</manifest>